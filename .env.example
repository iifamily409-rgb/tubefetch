VITE_APP_NAME=TubeFetch
VITE_APP_URL=http://localhost:5173

# =============================================================================
# VIDEO DOWNLOAD PROVIDER CONFIGURATION
# =============================================================================
# TubeFetch uses cobalt (https://github.com/imputnet/cobalt) as the download
# provider. Cobalt is an open-source media processing API.
#
# IMPORTANT: The official api.cobalt.tools instance has bot protection and
# is NOT intended for programmatic use. You must either:
#
# Option A: Self-host a cobalt instance
#   - Deploy cobalt on Railway, Render, Fly.io, or any Docker host
#   - Guide: https://github.com/imputnet/cobalt/blob/main/docs/run-an-instance.md
#   - Set COBALT_API_URL to your instance URL
#   - Optionally set COBALT_API_KEY if your instance requires auth
#
# Option B: Use a community cobalt instance
#   - Find instances at: https://instances.cobalt.best/
#   - Some instances allow API access with a key
#   - Contact the instance owner for access
#
# Without a configured provider, the app will:
#   - Still analyze videos (using YouTube's public oEmbed API)
#   - Show a clear error when download is attempted
#   - Display setup instructions in the error message
# =============================================================================

COBALT_API_URL=
COBALT_API_KEY=
