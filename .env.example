VITE_APP_NAME=TubeFetch
VITE_APP_URL=http://localhost:5173

# =============================================================================
# VIDEO DOWNLOAD PROVIDER CONFIGURATION
# =============================================================================
# TubeFetch uses Cobalt (https://github.com/imputnet/cobalt) as the download
# provider. Cobalt is an open-source media processing API.
#
# IMPORTANT: Cobalt CANNOT run on Vercel. It requires:
# - ffmpeg (for video/audio processing)
# - Persistent Node.js processes
# - Docker container or VPS
#
# You must deploy Cobalt separately and point VIDEO_PROVIDER_URL to it.
#
# =============================================================================
# OPTION 1: Railway One-Click Deploy (Easiest)
# =============================================================================
# 1. Go to: https://railway.com/deploy/cobalt-self-hosted-fix-youtube-downloads-on-railway--cobalt-youtube-downloader
# 2. Click "Deploy" and follow the setup
# 3. Railway will give you a URL like: https://cobalt-xxxx.up.railway.app
# 4. Copy that URL and set it as VIDEO_PROVIDER_URL below
#
# Railway pricing:
# - $5 free credit per month (no credit card required)
# - Cobalt typically uses ~$2-5/month for light usage
# - If you exceed free credits, plans start at $5/month
#
# =============================================================================
# OPTION 2: Self-Host with Docker (Full Control)
# =============================================================================
# 1. Install Docker on any VPS (DigitalOcean, Hetzner, etc.)
# 2. Follow: https://github.com/imputnet/cobalt/blob/main/docs/run-an-instance.md
# 3. Set VIDEO_PROVIDER_URL to your instance URL
#
# =============================================================================
# OPTION 3: Community Cobalt Instance
# =============================================================================
# Some community instances allow API access. Find them at:
# https://instances.cobalt.best/
# Contact the instance owner for access and API key if needed.
#
# =============================================================================
# ENVIRONMENT VARIABLES
# =============================================================================

# (Required for downloads) URL of your Cobalt instance
# Example: https://cobalt-xxxx.up.railway.app
VIDEO_PROVIDER_URL=

# (Optional) API key if your Cobalt instance requires authentication
# Leave empty if your instance doesn't require auth
VIDEO_PROVIDER_API_KEY=
