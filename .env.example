VITE_APP_NAME=TubeFetch
VITE_APP_URL=http://localhost:5173

# Video download provider configuration
# These are REQUIRED for actual video downloads to work.
# The VIDEO_PROVIDER_URL should point to an API that accepts:
#   POST { videoId, formatId, quality?, format? }
# And returns either:
#   - A direct media stream (video/mp4, audio/mpeg, etc.)
#   - A JSON response with a "url" field pointing to the media
#
# Compatible providers include:
#   - RapidAPI YouTube download APIs
#   - Self-hosted yt-dlp API servers
#   - Any custom API that returns downloadable media
VIDEO_PROVIDER_URL=
VIDEO_PROVIDER_API_KEY=
