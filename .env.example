VITE_APP_NAME=TubeFetch
VITE_APP_URL=http://localhost:5173

# =============================================================================
# VIDEO DOWNLOAD PROVIDER CONFIGURATION
# =============================================================================
# TubeFetch supports Piped and Invidious as video providers.
# These are open-source YouTube frontends that provide REST APIs.
#
# IMPORTANT: You must configure a provider to enable downloads.
# Without a provider, video analysis works but downloads fail.
#
# =============================================================================
# PROVIDER SELECTION
# =============================================================================
# Set VIDEO_PROVIDER_TYPE to either 'piped' or 'invidious'
VIDEO_PROVIDER_TYPE=

# =============================================================================
# PIPED CONFIGURATION
# =============================================================================
# Piped is a popular YouTube frontend with a REST API.
# Documentation: https://piped-docs.kavin.rocks/
#
# Public instances (may have rate limits):
# - https://pipedapi.kavin.rocks
# - https://pipedapi.adminforge.de
# - https://pipedapi.in.projectsegfau.lt
#
# More instances: https://github.com/TeamPiped/Piped/wiki/Instances
#
# Example:
# VIDEO_PROVIDER_TYPE=piped
# VIDEO_PROVIDER_URL=https://pipedapi.kavin.rocks
#
# =============================================================================
# INVIDIOUS CONFIGURATION
# =============================================================================
# Invidious is another popular YouTube frontend with a REST API.
# Documentation: https://docs.invidious.io/api/
#
# Public instances (may have rate limits):
# - https://vid.puffyan.us
# - https://invidious.snopyta.org
# - https://yewtu.be
#
# More instances: https://api.invidious.io/
#
# Example:
# VIDEO_PROVIDER_TYPE=invidious
# VIDEO_PROVIDER_URL=https://vid.puffyan.us
#
# =============================================================================
# PROVIDER URL (REQUIRED FOR DOWNLOADS)
# =============================================================================
# Set this to the base URL of your chosen provider instance.
# Do NOT include a trailing slash.
VIDEO_PROVIDER_URL=

# =============================================================================
# PROVIDER API KEY (OPTIONAL)
# =============================================================================
# Some provider instances may require an API key.
# Leave this empty if your instance doesn't require authentication.
VIDEO_PROVIDER_API_KEY=

# =============================================================================
# NOTES
# =============================================================================
# - Public instances may have rate limits or availability issues
# - For production use, consider self-hosting your own instance
# - Piped self-hosting: https://docs.piped.video/docs/installation/
# - Invidious self-hosting: https://docs.invidious.io/installation/
# - Never commit real API keys to version control
# =============================================================================
